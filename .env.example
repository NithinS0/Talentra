# =============================================================================
# Talentra — Local Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    Copy-Item .env.example .env
# 2. Replace the placeholder values with your actual Supabase credentials.
# 3. NEVER commit the actual '.env' file or secret keys to version control.
# =============================================================================

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Database Connection (Supabase PostgreSQL with Psycopg 3 driver)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# NOTE ON SPECIAL CHARACTERS IN PASSWORDS:
# If your password contains special characters (e.g. @, #, :, %, ?, /),
# they must be URL-encoded in the connection string:
#   @ -> %40
#   # -> %23
#   : -> %3A
#   % -> %25
#   ? -> %3F
#   / -> %2F
#   $ -> %24
#
# Direct Connection (Port 5432) - REQUIRED for Alembic migrations & DDL schema operations:
DATABASE_URL="postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres"

# Direct migration URL override (optional, if DATABASE_URL uses session pooler in runtime):
MIGRATION_DATABASE_URL=

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Optional Supabase API Credentials (for Auth / Storage client SDK if used)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_jwt_key_placeholder
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_placeholder
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_placeholder


# Payment Provider Configuration (Stage 11: Subscriptions, Wallet & Payments)
# Supported Providers: STRIPE, RAZORPAY, MOCK
PAYMENT_DEFAULT_PROVIDER=STRIPE
STRIPE_PUBLIC_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Notification & Delivery Provider Configuration (Stage 12: Notifications & Community)
# Supported Channels: EMAIL (SendGrid/SMTP), SMS (Twilio), PUSH (FCM/WebPush), IN_APP
NOTIFICATION_DEFAULT_EMAIL_PROVIDER=SENDGRID
SENDGRID_API_KEY=SG.placeholder_api_key
SENDGRID_FROM_EMAIL=notifications@talentra.com

NOTIFICATION_DEFAULT_SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=AC_placeholder_sid
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_FROM_NUMBER=+15005550006

NOTIFICATION_DEFAULT_PUSH_PROVIDER=FCM
FCM_SERVER_KEY=placeholder_fcm_key
NOTIFICATION_RETENTION_DAYS_DEFAULT=90

# Government Document Verification & Identity Compliance (Stage 14: Module M12)
# Supported Providers: SUREPASS, DIGILOCKER, KARZA, MOCK_PROVIDER
VERIFICATION_DEFAULT_PROVIDER=SUREPASS
SUREPASS_API_KEY=sp_live_placeholder_secret_key
SUREPASS_API_BASE_URL=https://kyc.surepass.io/api/v1
VERIFICATION_WEBHOOK_SECRET=talentra_webhook_secret_key_2026
STORAGE_SIGNING_PEPPER=talentra_storage_signing_pepper_2026

# Document Malware & Threat Scanning (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=8

# Data Retention Schedules
RETENTION_KYC_DOCUMENTS_DAYS=2555
RETENTION_INACTIVE_SESSIONS_DAYS=30
RETENTION_PROCESSED_WEBHOOKS_DAYS=90


